+static bool
+flush_nonblocking(struct sudo_event *ev)
+{
+    const int fd = sudo_ev_get_fd(ev);
+    int flags = fcntl(fd, F_GETFL, 0);
+
+    return flags != -1 && (ISSET(flags, O_NONBLOCK) ||
+	fcntl(fd, F_SETFL, flags | O_NONBLOCK) != -1);
+}
+
+static bool
+flush_interrupted(struct exec_closure *ec)
+{
+    return ec->evbase->signal_pending[SIGHUP] ||
+	ec->evbase->signal_pending[SIGINT] ||
+	ec->evbase->signal_pending[SIGQUIT] ||
+	ec->evbase->signal_pending[SIGTERM] ||
+	ec->evbase->signal_pending[SIGALRM] ||
+	ec->evbase->signal_pending[SIGUSR1] ||
+	ec->evbase->signal_pending[SIGUSR2];
+}

# Temporary, fail-closed host routing for Stealth.
# No existing nftables tables are flushed. Tor must run as the tor user.
add table inet stealth

add chain inet stealth nat_output { type nat hook output priority dstnat; policy accept; }
add chain inet stealth filter_output { type filter hook output priority filter; policy drop; }
add chain inet stealth filter_forward { type filter hook forward priority filter; policy drop; }

# Tor's own relay connections must leave directly or the proxy loops.
add rule inet stealth nat_output meta skuid tor return
# IPv6 and non-TCP traffic are blocked by the output filter below.
add rule inet stealth nat_output meta nfproto ipv6 return
# DNS is redirected before the loopback exemption, including local DNS stubs.
add rule inet stealth nat_output udp dport 53 redirect to :5353
add rule inet stealth nat_output ip daddr 127.0.0.0/8 return
add rule inet stealth nat_output meta nfproto ipv4 meta l4proto tcp redirect to :9040

# Redirected traffic reaches local Tor listeners. Tor uses TCP to relays.
add rule inet stealth filter_output oifname "lo" accept
add rule inet stealth filter_output ip daddr 127.0.0.1 tcp dport 9040 accept
add rule inet stealth filter_output ip daddr 127.0.0.1 udp dport 5353 accept
add rule inet stealth filter_output meta nfproto ipv4 oifname $uplink meta skuid tor meta l4proto tcp accept
# DHCP remains available only on the selected uplink.
add rule inet stealth filter_output meta nfproto ipv4 oifname $uplink meta skuid 0 udp sport 68 udp dport 67 accept

# Other host traffic, IPv6, and forwarded container traffic are blocked.
